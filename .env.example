# Canonical public origin; never use a temporary preview hostname.
NEXT_PUBLIC_SITE_URL=https://dreamspaceinteriors.co
# Raw token from Google Search Console; leave blank until ownership is verified.
GOOGLE_SITE_VERIFICATION=
# Optional real GA4 measurement ID (G-...). No analytics runs when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set true on public staging environments; keep false on the production domain.
SITE_NOINDEX=false
